#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
import re
import sqlite3
import stat
import sys
import time
from contextlib import closing
from pathlib import Path

def default_db_dir():
  if os.environ.get("CCSI_DB_DIR"):
    return os.path.expanduser(os.environ["CCSI_DB_DIR"])
  if sys.platform == "darwin":
    return os.path.expanduser("~/Library/Caches/cc-session-index")
  xdg = os.environ.get("XDG_CACHE_HOME", "")
  cache_home = xdg if os.path.isabs(xdg) else os.path.expanduser("~/.cache")
  return os.path.join(cache_home, "cc-session-index")


def follow_root_link(path):
  if not os.path.islink(path):
    return path
  target = os.readlink(path)
  return os.path.normpath(target if os.path.isabs(target) else os.path.join(os.path.dirname(path), target))


def build_roots():
  cc_cfg = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")
  codex_home = os.path.expanduser(os.environ.get("CODEX_HOME") or "~/.codex")
  pi_dir = os.path.expanduser(os.environ.get("PI_CODING_AGENT_DIR") or "~/.pi/agent")
  # Account config dirs link their projects/ to one shared directory; following that last link keeps
  # one path per transcript, otherwise each CLAUDE_CONFIG_DIR adds a copy that prune never removes.
  # Only the root's own link is followed: a full realpath would also rewrite /var to /private/var
  # and stop matching paths stored by earlier versions.
  return tuple(
    (vendor, follow_root_link(path))
    for vendor, path in (
      ("cc", os.path.join(cc_cfg, "projects")),
      ("codex", os.path.join(codex_home, "sessions")),
      ("codex", os.path.join(codex_home, "archived_sessions")),
      ("pi", os.path.join(pi_dir, "sessions")),
    )
  )


ROOTS = build_roots()
ROOT = ROOTS[0][1]
VENDORS = ("cc", "codex", "pi")
DB_DIR = default_db_dir()
DB_PATH = Path(DB_DIR) / "index.sqlite"
SCHEMA_VERSION = 3
EXTRACTOR_VERSION = 1

SCHEMA = """
CREATE TABLE paths (
  path_id INTEGER PRIMARY KEY,
  path TEXT NOT NULL UNIQUE,
  vendor TEXT NOT NULL
);
CREATE TABLE files (
  path_id INTEGER PRIMARY KEY REFERENCES paths(path_id),
  mtime REAL NOT NULL,
  size INTEGER NOT NULL,
  offset INTEGER NOT NULL,
  ino INTEGER NOT NULL,
  rows INTEGER NOT NULL
);
CREATE TABLE message_refs (
  mid INTEGER PRIMARY KEY,
  path_id INTEGER NOT NULL REFERENCES paths(path_id),
  ordinal INTEGER NOT NULL,
  ts TEXT NOT NULL,
  role TEXT NOT NULL
);
CREATE INDEX message_refs_path_id ON message_refs(path_id);
CREATE TABLE metadata (key TEXT PRIMARY KEY, value INTEGER NOT NULL);
CREATE VIRTUAL TABLE messages USING fts5(
  text, tokenize='trigram', content='', contentless_delete=1
);
"""

COMMAND_NAME_RE = re.compile(r"<command-name>\s*([^<]+?)\s*</command-name>")
COMMAND_ARGS_RE = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.DOTALL)
TASK_SUMMARY_RE = re.compile(r"<summary>\s*(.*?)\s*</summary>", re.DOTALL)
TASK_RESULT_RE = re.compile(r"<result>\s*(.*?)\s*</result>", re.DOTALL)
SKILL_BASE_RE = re.compile(r"^\s*Base directory for this skill(?:\s*:|\s*\r?\n)")
PURE_NOISE_RE = re.compile(r"^\s*<(?:local-command-caveat|local-command-stdout|system-reminder)\b")


def set_private_mode(path, mode):
  try:
    os.chmod(path, mode)
  except OSError:
    pass


def schema_version(db):
  return db.execute("PRAGMA user_version").fetchone()[0]


def indexed_extractor_version(db):
  row = db.execute("SELECT value FROM metadata WHERE key = 'extractor_version'").fetchone()
  return row[0] if row else None


def execute_fts_schema(db, schema):
  try:
    db.executescript(schema)
  except sqlite3.OperationalError as exc:
    if not any(term in str(exc).lower() for term in ("fts5", "trigram", "contentless_delete")):
      raise
    print(f"ccsi: SQLite 3.43+ with FTS5 trigram is required (running {sys.executable} with SQLite {sqlite3.sqlite_version}): {exc}",
          file=sys.stderr)
    sys.exit(2)


def initialize_index(db):
  execute_fts_schema(db, SCHEMA)
  db.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
  db.execute("INSERT INTO metadata VALUES ('extractor_version', ?)", (EXTRACTOR_VERSION,))
  db.commit()


def vendor_of(path):
  for vendor, root in ROOTS:
    if path.startswith(root + os.sep):
      return vendor, root
  return "cc", ROOT


def iter_files(vendors, onerror=None):
  for vendor, root in ROOTS:
    if vendor not in vendors or not os.path.isdir(root):
      continue
    for dirpath, dirs, names in os.walk(root, onerror=onerror):
      # Prune mirrored Codex rollouts under <cc_root>/codex so they are not indexed twice.
      if vendor == "cc" and dirpath == root and "codex" in dirs:
        dirs.remove("codex")
      for n in names:
        if n.endswith(".jsonl"):
          yield vendor, os.path.join(dirpath, n)


def read_jsonl_records(path, start_offset=0, indexed_identity=None):
  records = []
  # A replacement FIFO must not stall search before fstat can reject it.
  opener = (lambda name, flags: os.open(name, flags | os.O_NONBLOCK)) if indexed_identity else None
  with open(path, "rb", opener=opener) as f:
    st = os.fstat(f.fileno())
    if indexed_identity is not None:
      indexed_size, indexed_inode = indexed_identity
      if not stat.S_ISREG(st.st_mode) or st.st_ino != indexed_inode or st.st_size < indexed_size:
        return st, 0, records
    if start_offset > 0:
      f.seek(start_offset)
    consumed = start_offset
    while f.tell() < st.st_size:
      line_start = f.tell()
      raw = f.readline(st.st_size - line_start)
      if not raw:
        break
      line_end = f.tell()
      text = raw.decode("utf-8", errors="replace")
      if raw.endswith(b"\n"):
        consumed = line_end
        try:
          obj = json.loads(text)
        except json.JSONDecodeError:
          continue
        if isinstance(obj, dict):
          records.append(obj)
      else:
        try:
          obj = json.loads(text)
        except json.JSONDecodeError:
          # Incomplete trailing line from a live writer: hold cursor at line_start
          # so the next incremental pass reads the completed JSON object.
          break
        consumed = line_end
        if isinstance(obj, dict):
          records.append(obj)
  return st, consumed, records


def load_lines(path):
  _, _, records = read_jsonl_records(path, 0)
  yield from records


def as_text(value):
  if isinstance(value, str):
    return value
  if value is None:
    return ""
  try:
    return json.dumps(value, ensure_ascii=False, default=str)
  except (TypeError, ValueError):
    return str(value)


def summarize_tool_input(name, inp):
  if not isinstance(inp, dict) or not inp:
    return ""
  for k in ("command", "prompt", "query", "file_path", "notebook_path", "url"):
    if inp.get(k):
      return as_text(inp[k])
  if name == "Skill":
    return f"{as_text(inp.get('skill', ''))} {as_text(inp.get('args', ''))}".strip()
  if name in ("Grep", "Glob"):
    return f"{as_text(inp.get('pattern', ''))} {as_text(inp.get('path', ''))}".strip()
  if name == "SendMessage":
    return f"{as_text(inp.get('to', ''))} {as_text(inp.get('summary', ''))} {as_text(inp.get('message', ''))}".strip()
  if name == "Workflow":
    return f"{as_text(inp.get('name', ''))} {as_text(inp.get('script', ''))}".strip()
  return as_text(inp)


def normalize_fts_text(text):
  s = text.strip()
  if not s or SKILL_BASE_RE.match(s):
    return ""
  if s.startswith(("<command-message>", "<command-name>")):
    m_name = COMMAND_NAME_RE.search(s)
    if m_name:
      m_args = COMMAND_ARGS_RE.search(s)
      args_part = m_args.group(1).strip() if m_args else ""
      return f"{m_name.group(1).strip()} {args_part}".strip()
  if "<task-notification>" in s and s.startswith(("<task-notification>", "[SYSTEM NOTIFICATION", "<system-reminder>")):
    m_sum = TASK_SUMMARY_RE.search(s)
    m_res = TASK_RESULT_RE.search(s)
    parts = [p.group(1).strip() for p in (m_sum, m_res) if p and p.group(1).strip()]
    return ("[task-notification] " + " — ".join(parts)) if parts else ""
  if PURE_NOISE_RE.match(s):
    return ""
  return s


def cc_blocks(content):
  if isinstance(content, str):
    yield ("text", content, None)
    return
  if not isinstance(content, list):
    return
  for block in content:
    if not isinstance(block, dict):
      continue
    btype = block.get("type")
    if btype == "text":
      yield ("text", as_text(block.get("text", "")), None)
    elif btype == "tool_use":
      inp = block.get("input") if isinstance(block.get("input"), dict) else {}
      tname = as_text(block.get("name", ""))
      cmd = inp.get("command") or inp.get("prompt") or inp.get("query") or summarize_tool_input(tname, inp)
      yield ("tool_call", as_text(cmd), {"tool": tname, "input": inp})
    elif btype == "tool_result":
      c = block.get("content")
      text = c if isinstance(c, str) else " ".join(as_text(x.get("text", "")) for x in c if isinstance(x, dict)) if isinstance(c, list) else ""
      yield ("tool_result", as_text(text), None)


def codex_text(content):
  if isinstance(content, str):
    return content
  if isinstance(content, list):
    return "\n".join(as_text(x.get("text", "")) for x in content if isinstance(x, dict) and x.get("type") in ("input_text", "output_text", "text"))
  return ""


def events_cc(path, records=None, include_input=False):
  session = os.path.splitext(os.path.basename(path))[0]
  for obj in (records if records is not None else load_lines(path)):
    if obj.get("type") not in (None, "user", "assistant"):
      continue
    msg = obj.get("message")
    if not isinstance(msg, dict):
      continue
    is_meta = bool(obj.get("isMeta") or msg.get("isMeta"))
    origin = obj.get("origin") if isinstance(obj.get("origin"), dict) else {}
    raw_role = as_text(msg.get("role", obj.get("type")))
    if obj.get("isCompactSummary") or origin.get("kind") == "task-notification":
      raw_role = "system"
    base = {"vendor": "cc", "session": obj.get("sessionId") or session, "path": path, "ts": as_text(obj.get("timestamp", "")), "cwd": as_text(obj.get("cwd", "")), "role": raw_role, "model": as_text(msg.get("model", ""))}
    for kind, text, extra in cc_blocks(msg.get("content")):
      if kind == "text" and (is_meta or not text.strip()):
        continue
      ev = dict(base, kind=kind, text=text[:8000])
      if extra:
        ev["tool"] = extra["tool"]
        if include_input:
          ev["_input"] = extra["input"]
        if extra["tool"] == "Agent":
          ev["agent_type"] = as_text(extra["input"].get("subagent_type", ""))
          ev["agent_model"] = as_text(extra["input"].get("model", ""))
        if extra["tool"] == "Skill":
          ev["skill"] = as_text(extra["input"].get("skill", ""))
      yield ev


def events_codex(path, records=None, include_input=False):
  session = os.path.splitext(os.path.basename(path))[0]
  cwd = ""
  model = ""
  effort = ""
  role_tag = ""
  for obj in (records if records is not None else load_lines(path)):
    t = obj.get("type")
    p = obj.get("payload")
    if not isinstance(p, dict):
      p = {}
    ts = as_text(obj.get("timestamp", ""))
    if t == "session_meta":
      session = as_text(p.get("id")) or session
      cwd = as_text(p.get("cwd")) or cwd
      sub = ((p.get("source") or {}).get("subagent") or {}) if isinstance(p.get("source"), dict) else {}
      spawn = sub.get("thread_spawn") if isinstance(sub, dict) else None
      role_tag = as_text((spawn or {}).get("agent_role", "")) if isinstance(spawn, dict) else (as_text(sub.get("other", "")) if isinstance(sub, dict) else "")
      yield {"vendor": "codex", "session": session, "path": path, "ts": ts, "cwd": cwd, "role": "meta", "kind": "session_meta", "text": "", "model": "", "agent_role": role_tag, "originator": as_text(p.get("originator", ""))}
      continue
    if t == "turn_context":
      model = as_text(p.get("model")) or model
      effort = as_text(p.get("effort")) or effort
      cwd = as_text(p.get("cwd")) or cwd
      yield {"vendor": "codex", "session": session, "path": path, "ts": ts, "cwd": cwd, "role": "meta", "kind": "turn_context", "text": "", "model": model, "effort": effort, "agent_role": role_tag}
      continue
    if t != "response_item":
      continue
    base = {"vendor": "codex", "session": session, "path": path, "ts": ts, "cwd": cwd, "model": model, "effort": effort, "agent_role": role_tag}
    pt = p.get("type")
    if pt == "message":
      text = codex_text(p.get("content"))
      if text.strip():
        yield dict(base, role=as_text(p.get("role", "")), kind="text", text=text[:8000])
    elif pt in ("function_call", "custom_tool_call"):
      args = p.get("arguments") if pt == "function_call" else p.get("input")
      parsed = None
      if isinstance(args, str):
        try:
          parsed = json.loads(args)
        except ValueError:
          parsed = None
      elif isinstance(args, dict):
        parsed = args
      text = args if isinstance(args, str) else json.dumps(args, ensure_ascii=False)
      ev = dict(base, role="assistant", kind="tool_call", tool=as_text(p.get("name", "")), text=(text or "")[:8000])
      if include_input and isinstance(parsed, dict):
        ev["_input"] = parsed
      if isinstance(parsed, dict) and p.get("name") == "spawn_agent":
        ev["agent_type"] = as_text(parsed.get("agent_type", ""))
      yield ev
    elif pt in ("function_call_output", "custom_tool_call_output"):
      out = p.get("output")
      text = out if isinstance(out, str) else json.dumps(out, ensure_ascii=False)
      yield dict(base, role="tool", kind="tool_result", text=(text or "")[:8000])


def events_pi(path, records=None, include_input=False):
  session = os.path.splitext(os.path.basename(path))[0]
  cwd = ""
  model = ""
  for obj in (records if records is not None else load_lines(path)):
    t = obj.get("type")
    ts = as_text(obj.get("timestamp", ""))
    if t == "session":
      session = as_text(obj.get("id")) or session
      cwd = as_text(obj.get("cwd")) or cwd
      yield {"vendor": "pi", "session": session, "path": path, "ts": ts, "cwd": cwd, "role": "meta", "kind": "session_meta", "text": "", "model": ""}
      continue
    if t == "model_change":
      prov = as_text(obj.get("provider", ""))
      mid = as_text(obj.get("modelId", ""))
      model = f"{prov}/{mid}".strip("/") if (prov or mid) else model
      continue
    if t != "message":
      continue
    msg = obj.get("message")
    if not isinstance(msg, dict):
      continue
    role = as_text(msg.get("role", ""))
    base = {"vendor": "pi", "session": session, "path": path, "ts": ts, "cwd": cwd, "role": role, "model": model}
    content = msg.get("content")
    if role == "toolResult":
      text = content if isinstance(content, str) else " ".join(as_text(x.get("text", "")) for x in content if isinstance(x, dict) and x.get("type") == "text") if isinstance(content, list) else ""
      yield dict(base, role="tool", kind="tool_result", tool=as_text(msg.get("toolName", "")), text=as_text(text)[:8000])
      continue
    if isinstance(content, str):
      if content.strip():
        yield dict(base, kind="text", text=content[:8000])
      continue
    if not isinstance(content, list):
      continue
    for block in content:
      if not isinstance(block, dict):
        continue
      bt = block.get("type")
      if bt == "text":
        txt = as_text(block.get("text", ""))
        if txt.strip():
          yield dict(base, kind="text", text=txt[:8000])
      elif bt == "toolCall":
        tname = as_text(block.get("name", ""))
        args = block.get("arguments")
        inp = args if isinstance(args, dict) else {}
        summary = summarize_tool_input(tname, inp) if inp else as_text(args)
        ev = dict(base, role="assistant", kind="tool_call", tool=tname, text=summary[:8000])
        if include_input:
          ev["_input"] = inp
        yield ev


PARSERS = {
  "cc": events_cc,
  "codex": events_codex,
  "pi": events_pi,
}


def events_for(vendor, path, records=None, include_input=False):
  parser = PARSERS.get(vendor, events_codex)
  return parser(path, records=records, include_input=include_input)


def extract_rows(path, vendor=None, records=None):
  vendor = vendor or vendor_of(path)[0]
  rows = []
  for ev in events_for(vendor, path, records=records, include_input=True):
    if ev["kind"] == "text":
      text = normalize_fts_text(ev["text"])
    elif ev["kind"] == "tool_call":
      tool = ev.get("tool", "")
      body = ev["text"].strip()
      if not body and isinstance(ev.get("_input"), dict):
        body = summarize_tool_input(tool, ev["_input"]).strip()
      if body:
        text = f"[{tool}] {body}"[:2000]
      else:
        text = ""
    else:
      continue
    if text:
      rows.append((text[:8000], path, ev["ts"], ev["role"]))
  return rows


# Keep the preceding extractor available when introducing a new version so searches
# use the same ordinal mapping until the rebuilt database replaces the old one.
EXTRACTORS = {1: extract_rows}


def delete_file_messages(db, path_id):
  db.execute("DELETE FROM messages WHERE rowid IN (SELECT mid FROM message_refs WHERE path_id = ?)", (path_id,))
  db.execute("DELETE FROM message_refs WHERE path_id = ?", (path_id,))


def prune_deleted_files(db, vendors, known, unseen):
  roots = [root for vendor, root in ROOTS if vendor in vendors]
  for path in unseen:
    matching_roots = [root for root in roots if path.startswith(root + os.sep)]
    if not matching_roots:
      continue
    try:
      os.stat(path)
    except FileNotFoundError:
      if any(os.path.isdir(root) for root in matching_roots):
        path_id = known[path][5]
        delete_file_messages(db, path_id)
        db.execute("DELETE FROM files WHERE path_id = ?", (path_id,))
        db.execute("DELETE FROM paths WHERE path_id = ?", (path_id,))
    except OSError:
      continue


def update_index(db, vendors, indexed_paths=frozenset()):
  known = {
    path: (mtime, size, offset, ino, rows, path_id)
    for path, mtime, size, offset, ino, rows, path_id in db.execute(
      "SELECT path, mtime, size, offset, ino, rows, path_id FROM files JOIN paths USING (path_id)"
    )
  }
  unseen = set(known)
  next_mid = db.execute("SELECT coalesce(max(mid), 0) FROM message_refs").fetchone()[0]
  scanned = updated = failed = 0

  def record_read_error(exc, path):
    nonlocal failed
    failed += 1
    print(f"skip unreadable source: {exc}", file=sys.stderr)
    if path in indexed_paths:
      sys.exit("ccsi: rebuild could not read an indexed session; kept the existing index")

  def record_walk_error(exc):
    directory = exc.filename
    if directory and any(path.startswith(directory + os.sep) for path in indexed_paths):
      print(f"skip unreadable source: {exc}", file=sys.stderr)
      sys.exit("ccsi: rebuild could not scan indexed sessions; kept the existing index")
    record_read_error(exc, directory)

  for vendor, path in iter_files(vendors, onerror=record_walk_error):
    try:
      st_pre = os.stat(path)
    except FileNotFoundError:
      continue
    except OSError as exc:
      record_read_error(exc, path)
      continue
    unseen.discard(path)
    scanned += 1
    prev = known.get(path)
    if prev is not None and prev[0] == st_pre.st_mtime and prev[1] == st_pre.st_size and prev[3] == st_pre.st_ino:
      continue
    can_append = (
      prev is not None
      and prev[3] == st_pre.st_ino
      and st_pre.st_size > prev[1]
      and prev[2] > 0
    )
    start_offset = prev[2] if can_append else 0
    try:
      st, new_offset, records = read_jsonl_records(path, start_offset)
      if can_append and (st.st_ino != prev[3] or st.st_size <= prev[1]):
        can_append = False
        st, new_offset, records = read_jsonl_records(path)
      rows = EXTRACTORS[EXTRACTOR_VERSION](path, vendor, records=records)
    except OSError as exc:
      record_read_error(exc, path)
      continue
    if prev is None:
      path_id = db.execute("INSERT INTO paths (path, vendor) VALUES (?, ?)", (path, vendor)).lastrowid
    else:
      path_id = prev[5]
      if not can_append:
        delete_file_messages(db, path_id)
    base_rows = prev[4] if can_append else 0
    db.executemany(
      "INSERT INTO messages (rowid, text) VALUES (?, ?)",
      ((next_mid + i + 1, row[0]) for i, row in enumerate(rows)),
    )
    db.executemany(
      "INSERT INTO message_refs (mid, path_id, ordinal, ts, role) VALUES (?, ?, ?, ?, ?)",
      ((next_mid + i + 1, path_id, base_rows + i, ts, role) for i, (_, _, ts, role) in enumerate(rows)),
    )
    next_mid += len(rows)
    db.execute(
      "INSERT OR REPLACE INTO files (path_id, mtime, size, offset, ino, rows) VALUES (?, ?, ?, ?, ?, ?)",
      (path_id, st.st_mtime, st.st_size, new_offset, st.st_ino, base_rows + len(rows)),
    )
    known[path] = (st.st_mtime, st.st_size, new_offset, st.st_ino, base_rows + len(rows), path_id)
    updated += 1
    if updated % 500 == 0:
      db.commit()
  prune_deleted_files(db, vendors, known, unseen)
  db.commit()
  total = db.execute("SELECT coalesce(sum(rows), 0) FROM files").fetchone()[0]
  return scanned, updated, failed, total


def previously_indexed_paths(db, version):
  if not db.execute("SELECT 1 FROM sqlite_schema WHERE name = 'files'").fetchone():
    return set()
  table = "paths" if version == SCHEMA_VERSION else "files"
  return {path for (path,) in db.execute(f"SELECT path FROM {table}")}


def require_roots_for_rebuild(roots):
  missing = [root for root in roots if not os.path.isdir(root)]
  if missing:
    sys.exit(f"ccsi: kept the existing index; rebuild source unavailable: {', '.join(missing)}")


def rebuild_index(vendors, indexed_paths):
  required_roots = [root for vendor, root in ROOTS if vendor in vendors
                    and any(path.startswith(root + os.sep) for path in indexed_paths)]
  require_roots_for_rebuild(required_roots)
  staging = DB_PATH.with_suffix(".sqlite.rebuild")
  staging.with_name(staging.name + "-journal").unlink(missing_ok=True)
  staging.unlink(missing_ok=True)
  staging.touch(mode=0o600, exist_ok=False)
  try:
    with closing(sqlite3.connect(staging)) as db:
      initialize_index(db)
      counts = update_index(db, vendors, indexed_paths)
    require_roots_for_rebuild(required_roots)
    os.replace(staging, DB_PATH)
    return counts
  finally:
    staging.unlink(missing_ok=True)


def cmd_index(args):
  t0 = time.time()
  os.makedirs(DB_DIR, mode=0o700, exist_ok=True)
  set_private_mode(DB_DIR, 0o700)
  lock_path = os.path.join(DB_DIR, "index.lock")
  vendors = set(args.vendor or VENDORS)
  with open(lock_path, "w") as lock_file:
    set_private_mode(lock_path, 0o600)
    fcntl.flock(lock_file, fcntl.LOCK_EX)
    existing = DB_PATH.is_file()
    counts = None
    indexed_paths = frozenset()
    if existing:
      set_private_mode(DB_PATH, 0o600)
      with closing(sqlite3.connect(DB_PATH)) as db:
        version = schema_version(db)
        if version > SCHEMA_VERSION:
          sys.exit("ccsi: the index was built by a newer ccsi version")
        if version == SCHEMA_VERSION and indexed_extractor_version(db) == EXTRACTOR_VERSION:
          counts = update_index(db, vendors)
        elif args.vendor:
          sys.exit("ccsi: rebuilding the index requires all sources. Run ccsi index without --vendor.")
        else:
          indexed_paths = previously_indexed_paths(db, version)
    if counts is None:
      counts = rebuild_index(vendors, indexed_paths)
    scanned, updated, failed, total = counts
    print(f"scanned={scanned} updated={updated} failed={failed} rows={total} took={time.time()-t0:.1f}s")


FTS_SYNTAX_RE = re.compile(r'["*()^:]|\b(?:AND|OR|NOT|NEAR(?:/\d+)?)\b')
QUERY_TERM_RE = re.compile(r'"([^"]+)"|(\S+)')
NEAR_OP_RE = re.compile(r"^NEAR(?:/\d+)?$")


def literal_query(query):
  out = []
  for token in query.split():
    if token in ("AND", "OR", "NOT"):
      out.append(token)
    else:
      out.append('"' + token.replace('"', '""') + '"')
  return " ".join(out)


def escape_like(token):
  return "%" + token.replace("!", "!!").replace("%", "!%").replace("_", "!_") + "%"


def parse_search_query(query):
  has_long_term = False
  has_short_term = False
  for quoted, bare in QUERY_TERM_RE.findall(query):
    if quoted:
      if len(quoted) >= 3:
        has_long_term = True
      else:
        has_short_term = True
    elif bare not in ("AND", "OR", "NOT") and not NEAR_OP_RE.match(bare):
      cleaned = bare.strip('"*()^')
      if len(cleaned) >= 3:
        has_long_term = True
      elif cleaned:
        has_short_term = True
  if not has_long_term:
    return None, []
  if not FTS_SYNTAX_RE.search(query):
    tokens = query.split()
    long_tokens = [t for t in tokens if len(t) >= 3]
    short_tokens = [t for t in tokens if len(t) < 3]
    if short_tokens:
      return " ".join(long_tokens), short_tokens
  elif has_short_term:
    return None, []
  return query, []


def path_filters(args, path_column):
  sql, params = "", []
  if args.vendor:
    roots = [root for vendor, root in ROOTS if vendor in args.vendor]
    sql += " AND (" + " OR ".join(f"{path_column} LIKE ?" for _ in roots) + ")"
    params.extend(root + os.sep + "%" for root in roots)
  for ex in args.exclude_session:
    if ex:
      sql += f" AND {path_column} NOT LIKE ? ESCAPE '!'"
      params.append(escape_like(ex))
  return sql, params


def query_matches(db, sql, fts_query, params):
  try:
    return db.execute(sql, [fts_query, *params]), fts_query
  except sqlite3.OperationalError as exc:
    if "locked" in str(exc).lower() or "busy" in str(exc).lower():
      sys.exit(f"query error: {exc}")
    fts_query = literal_query(fts_query)
    try:
      return db.execute(sql, [fts_query, *params]), fts_query
    except sqlite3.OperationalError as retry_error:
      sys.exit(f"query error: {retry_error}")


def print_hit(path, ts, role, snippet):
  vendor, root = vendor_of(path)
  rel = os.path.relpath(path, root)
  print(f"--- [{vendor}] {rel}  {ts}  [{role}]")
  print(snippet.replace("\n", " ")[:500])


def print_context(marker, ts, role, text):
  print(f"  {marker} [{role} {ts}] {text.replace(chr(10), ' ')[:300]}")


def legacy_context(db, path, mid, count):
  return db.execute("""
    WITH before_hit AS (
      SELECT mid FROM message_refs WHERE path = :path AND mid < :mid ORDER BY mid DESC LIMIT :count
    ), after_hit AS (
      SELECT mid FROM message_refs WHERE path = :path AND mid > :mid ORDER BY mid ASC LIMIT :count
    ), context_rows AS (
      SELECT mid FROM before_hit UNION ALL SELECT :mid UNION ALL SELECT mid FROM after_hit
    )
    SELECT context_rows.mid, ts, role, text
    FROM context_rows CROSS JOIN messages ON messages.rowid = context_rows.mid
    ORDER BY context_rows.mid
  """, {"path": path, "mid": mid, "count": count})


def search_legacy(db, args, fts_query, short_tokens):
  # v2 searches can keep using the full-text copy while index builds v3 beside it.
  sql = (
    "SELECT rowid, path, ts, role, snippet(messages, 0, '>>>', '<<<', '…', 64) "
    "FROM messages WHERE messages MATCH ?"
  )
  filters, path_params = path_filters(args, "+path")
  sql += " AND +text LIKE ? ESCAPE '!'" * len(short_tokens)
  sql += filters + " ORDER BY rank LIMIT ?"
  params = [*(escape_like(token) for token in short_tokens), *path_params, args.k]
  hits = query_matches(db, sql, fts_query, params)[0].fetchall()
  for mid, path, ts, role, snip in hits:
    print_hit(path, ts, role, snip)
    if args.context > 0:
      for context_mid, context_ts, context_role, text in legacy_context(db, path, mid, args.context):
        marker = "-" if context_mid < mid else "+" if context_mid > mid else ">"
        print_context(marker, context_ts, context_role, text)
  return len(hits)


SQLITE_LIKE_FOLD = str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
TS_RAW_RE = re.compile(r"^[0-9A-Za-zT:.\-+_ ]+$")


def short_match(text, tokens):
  if not tokens:
    return True
  # SQLite's default LIKE folds ASCII only and stops at an embedded NUL.
  folded = text.split("\0", 1)[0].translate(SQLITE_LIKE_FOLD)
  return all(token.translate(SQLITE_LIKE_FOLD) in folded for token in tokens)


def read_hit_rows(extractor, path, vendor, indexed_size, indexed_inode):
  try:
    _, _, records = read_jsonl_records(path, indexed_identity=(indexed_size, indexed_inode))
  except OSError:
    return []
  return extractor(path, vendor, records=records)


def prefilter_hit_by_ts(path, vendor, ts, role, short_tokens, indexed_size, indexed_inode):
  # Fast negative filter for short-token queries: only JSON-parse lines containing ts_bytes.
  # Returns True if a candidate line matches (caller still verifies exact ordinal),
  # False if no line with ts can match, or None if the source file failed identity/read checks.
  try:
    opener = lambda name, flags: os.open(name, flags | os.O_NONBLOCK)
    with open(path, "rb", opener=opener) as f:
      st = os.fstat(f.fileno())
      if not stat.S_ISREG(st.st_mode) or st.st_ino != indexed_inode or st.st_size < indexed_size:
        return None
      buf = f.read(st.st_size)
  except OSError:
    return None
  ts_bytes = ts.encode("ascii")
  matched = []
  pos = buf.find(ts_bytes, 0)
  while pos != -1:
    line_start = buf.rfind(b"\n", 0, pos) + 1
    nl = buf.find(b"\n", pos)
    line_end = nl + 1 if nl != -1 else len(buf)
    try:
      obj = json.loads(buf[line_start:line_end].decode("utf-8", errors="replace"))
    except json.JSONDecodeError:
      obj = None
    if isinstance(obj, dict):
      matched.append(obj)
    pos = buf.find(ts_bytes, line_end)
  if not matched:
    return False
  rows = extract_rows(path, vendor, records=matched)
  return any(
    (ts, role) == (source_ts, source_role) and short_match(text, short_tokens)
    for text, _, source_ts, source_role in rows
  )


def snippet_for(temp, query, text):
  temp.execute("INSERT OR REPLACE INTO excerpts (rowid, text) VALUES (1, ?)", (text,))
  result = temp.execute(
    "SELECT snippet(excerpts, 0, '>>>', '<<<', '…', 64) FROM excerpts WHERE excerpts MATCH ?",
    (query,),
  ).fetchone()
  return result[0] if result else None


def search_contentless(db, extractor, args, fts_query, short_tokens):
  if args.k == 0:
    return 0
  sql = (
    "SELECT paths.path, paths.vendor, ordinal, ts, role, files.size, files.ino "
    "FROM messages JOIN message_refs ON mid = messages.rowid "
    "JOIN paths USING (path_id) JOIN files USING (path_id) "
    "WHERE messages MATCH ?"
  )
  filters, params = path_filters(args, "paths.path")
  hits, fts_query = query_matches(db, sql + filters + " ORDER BY rank", fts_query, params)
  by_path = {}
  found = 0
  with closing(sqlite3.connect(":memory:")) as temp:
    temp.execute("CREATE VIRTUAL TABLE excerpts USING fts5(text, tokenize='trigram')")
    for path, vendor, ordinal, ts, role, indexed_size, indexed_inode in hits:
      if path not in by_path:
        if short_tokens and extractor is extract_rows and ts and TS_RAW_RE.match(ts):
          pre = prefilter_hit_by_ts(path, vendor, ts, role, short_tokens, indexed_size, indexed_inode)
          if pre is None:
            by_path[path] = []
            continue
          if not pre:
            continue
        by_path[path] = read_hit_rows(extractor, path, vendor, indexed_size, indexed_inode)
      rows = by_path[path]
      if ordinal >= len(rows):
        continue
      text, _, source_ts, source_role = rows[ordinal]
      if (ts, role) != (source_ts, source_role):
        continue
      if not short_match(text, short_tokens):
        continue
      snippet = snippet_for(temp, fts_query, text)
      if snippet is None:
        continue
      print_hit(path, ts, role, snippet)
      if args.context > 0:
        for adjacent, _, cts, crole in rows[max(0, ordinal - args.context):ordinal]:
          print_context("-", cts, crole, adjacent)
        print_context(">", ts, role, text)
        for adjacent, _, cts, crole in rows[ordinal + 1:ordinal + 1 + args.context]:
          print_context("+", cts, crole, adjacent)
      found += 1
      if found == args.k:
        break
  return found


def cmd_search(args):
  query = " ".join(args.query)
  fts_query, short_tokens = parse_search_query(query)
  if fts_query is None:
    print(
      f"query error: trigram index requires >=3-char terms (or plain space-separated mixed terms without boolean/quoted <3-char tokens; got: {query})",
      file=sys.stderr,
    )
    sys.exit(2)
  if not DB_PATH.is_file():
    with closing(sqlite3.connect(":memory:")) as db:
      execute_fts_schema(db, "CREATE VIRTUAL TABLE messages USING fts5("
                            "text, path UNINDEXED, ts UNINDEXED, role UNINDEXED, tokenize='trigram')")
      search_legacy(db, args, fts_query, short_tokens)
    print("(no hits)")
    return
  with closing(sqlite3.connect(DB_PATH.resolve().as_uri() + "?mode=ro", uri=True)) as db:
    db.execute("BEGIN")
    version = schema_version(db)
    if version < SCHEMA_VERSION:
      found = search_legacy(db, args, fts_query, short_tokens)
    else:
      extractor = EXTRACTORS.get(indexed_extractor_version(db)) if version == SCHEMA_VERSION else None
      if extractor is None:
        sys.exit("ccsi: incompatible index version. Run ccsi index or use the matching ccsi version.")
      found = search_contentless(db, extractor, args, fts_query, short_tokens)
  if not found:
    print("(no hits)")


def cmd_events(args):
  since = args.since or ""
  kinds = set(args.kind) if args.kind else None
  out = sys.stdout
  for vendor, p in iter_files(set(args.vendor or VENDORS)):
    if args.session and args.session not in os.path.basename(p):
      continue
    if since:
      try:
        if time.strftime("%Y-%m-%d", time.localtime(os.stat(p).st_mtime)) < since:
          continue
      except OSError:
        continue
    try:
      for ev in events_for(vendor, p):
        if since and ev["ts"] and ev["ts"][:10] < since:
          continue
        if kinds and ev["kind"] not in kinds:
          continue
        if args.tool and (ev["kind"] != "tool_call" or ev.get("tool") != args.tool):
          continue
        out.write(json.dumps(ev, ensure_ascii=False) + "\n")
    except OSError as e:
      print(f"skip unreadable file: {p}: {e}", file=sys.stderr)
      continue


def main():
  ap = argparse.ArgumentParser(prog="ccsi", description="FTS index and normalized event stream over CC (~/.claude/projects), Codex (~/.codex/sessions, archived_sessions), and Pi (~/.pi/agent/sessions) jsonl")
  sub = ap.add_subparsers(dest="cmd", required=True)
  p_index = sub.add_parser("index", help="build or incrementally update the index")
  p_index.add_argument("--vendor", action="append", choices=VENDORS, help="restrict to one vendor (default all)")
  p_index.set_defaults(fn=cmd_index)
  p_search = sub.add_parser("search", help="full-text search indexed messages")
  p_search.add_argument("query", nargs="+")
  p_search.add_argument("-k", type=int, default=10)
  p_search.add_argument("--vendor", action="append", choices=VENDORS, help="restrict hits to one vendor")
  p_search.add_argument("--exclude-session", action="append", default=[], help="exclude session paths containing this substring")
  p_search.add_argument("-C", "--context", type=int, default=0, help="show N surrounding indexed messages from the same file")
  p_search.set_defaults(fn=cmd_search)
  p_events = sub.add_parser("events", help="stream normalized events as JSONL (vendor, session, ts, cwd, role, kind, tool, model, text)")
  p_events.add_argument("--vendor", action="append", choices=VENDORS)
  p_events.add_argument("--since", help="YYYY-MM-DD; skip files older than this and events before it")
  p_events.add_argument("--session", help="substring of the session file name")
  p_events.add_argument("--kind", action="append", choices=("text", "tool_call", "tool_result", "session_meta", "turn_context"))
  p_events.add_argument("--tool", help="only tool_call events for this tool name")
  p_events.set_defaults(fn=cmd_events)
  args = ap.parse_args()
  args.fn(args)


if __name__ == "__main__":
  main()
